<div class="workout">
  <%= pb_rails('title', props: {tag: 'h2'}) do %>
    <%= @routine.name %> — <%= @day.titleize %> — Round <%= params[:step] || 1 %>
  <% end %>

  <%= pb_rails('card') do%>
    <%= pb_rails('title', props: {tag: 'h3'}) do %>
      <%= @current_exercise.exercise.name %><%= " #{@current_exercise.label}" if @current_exercise.label.present? %>
    <% end %>

    <% if @current_exercise.rep_unit&.downcase == "seconds" %>
      <div
        class="workout-timer"
        data-controller="workout-timer"
        data-duration="<%= @current_exercise.reps %>"
        data-countdown-start-url="<%= asset_path('countdown-start.wav') %>"
        data-timer-done-url="<%= asset_path('timer-done.wav') %>"
      >
        <h2><strong>Timer:</strong> <span data-workout-timer-target="display">Ready to start</span></h2>
        <%= pb_rails('button', props: {variant: "secondary", text: 'Start timer', type: "button", data: {workout_timer_target: "startButton", action: "click->workout-timer#startTimer"}}) %>
      </div>
    <% end %>

    <% if @current_exercise.exercise.url %>
      <img src=<%= @current_exercise.exercise.url %> alt="" srcset="">
    <% end %>
    <p><strong>Sets:</strong> <%= @current_exercise.sets %></p>
    <p><strong>Reps:</strong> <%= @current_exercise.reps %> <%= @current_exercise.rep_unit %></p>
    <p><strong>Description:</strong> <%= @current_exercise.exercise.description %> </p>
  <% end %>

  <div class="workout-actions">
    <%= pb_rails('button', props: {link: routines_path, text: 'Cancel', variant: 'danger'}) %>
    <%= pb_rails('button', props: {link: workout_routine_path(@routine, @next_params), text: 'Next'}) %>
  </div>
</div>
